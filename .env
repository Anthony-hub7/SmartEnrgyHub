# ============================================================
# SmartEnergy Hub - Configuration centralisée (ENF-02)
# Aucune donnée sensible réelle : identifiants de développement local.
# ============================================================

# --- Redis ---
REDIS_PORT=6379
REDIS_STREAM=energy-measurements
REDIS_CONSUMER_GROUP=storage-group
# Mot de passe Redis : impose par docker-compose (command --requirepass) et lu par les
# services via spring.data.redis.password. Valeur de developpement local uniquement.
REDIS_PASSWORD=change-me

# --- Cassandra ---
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=smartenergy
CASSANDRA_CLUSTER_NAME=smartenergy-cluster
CASSANDRA_DC=dc1
CASSANDRA_MAX_HEAP=512M
CASSANDRA_HEAP_NEWSIZE=128M
# --- MongoDB ---
MONGO_PORT=27017
MONGO_DATABASE=smartenergy
MONGO_USER=smartenergy
MONGO_PASSWORD=smartenergy_dev
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_dev
# Utilisateurs applicatifs (init-mongo.js) : obligatoires pour l'interpolation docker-compose.
# ATTENTION : le volume etant deja initialise, ces comptes doivent etre crees/manages a l'etape 6.
MONGO_SENSOR_PASSWORD=change-me-sensor
MONGO_ANALYTICS_PASSWORD=change-me-analytics

# --- Services applicatifs ---
COLLECTOR_PORT=8081
STORAGE_PORT=8082
ANALYTICS_PORT=8083
# Prevision IA (extension 9C) : active la route GET /api/analytics/{id}/forecast.
# Le modele models/energy.onnx doit exister, sinon 501 FORECAST_DISABLED.
ANALYTICS_FORECAST_ENABLED=true
# Regle CDC 5.2 : age maximal d'une mesure. P31D autorise le backfill du simulateur
# (historique virtuel de 30 jours). A remettre PT24H hors backfill.
MEASUREMENT_MAX_AGE=P31D

# --- Simulateur ---
SIMULATOR_INTERVAL_SECONDS=2
SIMULATOR_SENSORS=SENSOR-001,SENSOR-002,SENSOR-003,SENSOR-004,SENSOR-005
SIMULATOR_COLLECTOR_URL=http://collector-service:8081/api/measurements
SIMULATOR_PEAK_FACTOR=3
SIMULATOR_PEAK_PROBABILITY=0.05

# --- Limites de ressources (limitation de volume/mémoire par conteneur) ---
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=96m
# CASSANDRA_MEM_LIMIT et CASSANDRA_MEM_RESERVATION retirées (pas de limite stricte)
# MONGO_MEM_LIMIT et MONGO_MEM_RESERVATION retirées (pas de limite stricte)
SPRING_MEM_LIMIT=512m
SPRING_JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC
