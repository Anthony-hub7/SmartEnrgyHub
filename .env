# ============================================================
# SmartEnergy Hub - Configuration centralisée (ENF-02)
# Aucune donnée sensible réelle : identifiants de développement local.
# ============================================================

# --- Redis ---
REDIS_PORT=6379
REDIS_STREAM=energy-measurements
REDIS_CONSUMER_GROUP=storage-group

# --- Cassandra ---
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=smartenergy
CASSANDRA_CLUSTER_NAME=smartenergy-cluster
CASSANDRA_DC=dc1
CASSANDRA_MAX_HEAP=512M
CASSANDRA_HEAP_NEWSIZE=128M

# --- MongoDB ---
MONGO_PORT=27017
MONGO_DATABASE=smartenergy
MONGO_USER=smartenergy
MONGO_PASSWORD=smartenergy_dev
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_dev

# --- Services applicatifs ---
COLLECTOR_PORT=8081
STORAGE_PORT=8082
ANALYTICS_PORT=8083

# --- Simulateur ---
SIMULATOR_INTERVAL_SECONDS=2
SIMULATOR_SENSORS=SENSOR-001,SENSOR-002,SENSOR-003,SENSOR-004,SENSOR-005
SIMULATOR_COLLECTOR_URL=http://collector-service:8081/api/measurements
SIMULATOR_PEAK_FACTOR=3
SIMULATOR_PEAK_PROBABILITY=0.05

# --- Limites de ressources (limitation de volume/mémoire par conteneur) ---
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=96m
CASSANDRA_MEM_LIMIT=1g
CASSANDRA_MEM_RESERVATION=512m
MONGO_MEM_LIMIT=512m
MONGO_MEM_RESERVATION=256m
SPRING_MEM_LIMIT=512m
SPRING_JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC
