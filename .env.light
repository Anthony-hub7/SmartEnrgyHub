# SmartEnergy Hub - environnement LEGER (Cassandra + Redis uniquement)
# Pour presentation vendredi : infrastructure Docker minimale, services Spring Boot en local.
# Usage : docker compose -f docker-compose.light.yml --env-file .env.light up -d

# --- Cassandra ---
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=smartenergy
CASSANDRA_CLUSTER_NAME=smartenergy-cluster
CASSANDRA_DC=datacenter1
CASSANDRA_MAX_HEAP=384M
CASSANDRA_HEAP_NEWSIZE=96M
CASSANDRA_MEM_LIMIT=768m
CASSANDRA_MEM_RESERVATION=384m

# --- Redis ---
REDIS_PORT=6379
REDIS_STREAM=energy-measurements
REDIS_CONSUMER_GROUP=storage-group
REDIS_PASSWORD=change-me
REDIS_MEM_LIMIT=128m
REDIS_MEM_RESERVATION=64m

# --- Host (services Spring Boot en local) ---
CASSANDRA_HOST=localhost
REDIS_HOST=localhost
